<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/arvin_widget_background">

    <TextView
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="یادآورهای آروین"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#242438"
        android:gravity="start" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="یادآور فعالی وجود ندارد"
        android:textColor="#77778A"
        android:gravity="start" />

    <LinearLayout
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:padding="10dp"
        android:background="#F7F7FC">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="یادآور"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#5B5DD6"
            android:gravity="start" />
        <TextView
            android:id="@+id/widget_title_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#242438"
            android:gravity="start" />
        <TextView
            android:id="@+id/widget_followup_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="#77778A"
            android:gravity="start" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:padding="10dp"
        android:background="#F7F7FC">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="یادآور"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#5B5DD6"
            android:gravity="start" />
        <TextView
            android:id="@+id/widget_title_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#242438"
            android:gravity="start" />
        <TextView
            android:id="@+id/widget_followup_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="#77778A"
            android:gravity="start" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:padding="10dp"
        android:background="#F7F7FC">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="یادآور"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#5B5DD6"
            android:gravity="start" />
        <TextView
            android:id="@+id/widget_title_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#242438"
            android:gravity="start" />
        <TextView
            android:id="@+id/widget_followup_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="#77778A"
            android:gravity="start" />
    </LinearLayout>
</LinearLayout>
